<script>
'use strict';
const APP_VERSION='v0.2.0';
const KB_EXPECTED_SHA256='7316506a4c963235b9983336dd891a13c2e81769599a34061a7821c160031756';
const SPECIES={
  dog:{l:'Dog',g:'Companion'},cat:{l:'Cat',g:'Companion'},rabbit:{l:'Rabbit',g:'Companion'},
  horse:{l:'Horse',g:'Equine'},
  cattle:{l:'Cattle',g:'Ruminant',food:1},sheep:{l:'Sheep',g:'Ruminant',food:1},goat:{l:'Goat',g:'Ruminant',food:1},deer:{l:'Deer',g:'Ruminant',food:1},
  pig:{l:'Pig',g:'Swine',food:1},
  chicken:{l:'Chicken',g:'Poultry',food:1},duck:{l:'Duck',g:'Poultry',food:1},turkey:{l:'Turkey',g:'Poultry',food:1},peafowl:{l:'Peafowl',g:'Poultry',food:1}
};
const TIERS={1:'OTC drug',2:'Rx drug',3:'Peptide / biologic',4:'Nutraceutical',5:'Herbal / TCVM',6:'Manual / physical',7:'Human meds at home'};
const TRI={E:'Emergency — go now',U:'See a veterinarian within 24 hours',S:'Book a visit (days)',H:'Home care is reasonable — watch for red flags'};
